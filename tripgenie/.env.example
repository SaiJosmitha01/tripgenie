SPRING_PROFILES_ACTIVE=local

# Security
JWT_SECRET=replace-with-a-strong-32-byte-secret
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Trip AI and maps
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
GOOGLE_MAPS_API_KEY=replace-with-your-google-maps-api-key

# PostgreSQL: use DATABASE_URL, or use explicit Spring datasource variables.
DATABASE_URL=postgres://username:password@hostname:5432/database_name
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/tripgenie
SPRING_DATASOURCE_USERNAME=tripgenie
SPRING_DATASOURCE_PASSWORD=tripgenie

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT=2s
CACHE_ENABLED=true
REDIS_HEALTH_ENABLED=true

# Kafka
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
NOTIFICATION_KAFKA_GROUP=notification-service
TRIP_AUDIT_KAFKA_GROUP=trip-service-audit
